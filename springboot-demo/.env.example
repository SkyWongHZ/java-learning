# Public local-development defaults used by compose.yaml.
# Copy this file to .env. Replace the values when using your own MySQL.
# Never commit the resulting .env.

SPRING_PROFILES_ACTIVE='dev'

# These values match the local MySQL service in compose.yaml.
DB_URL='jdbc:mysql://127.0.0.1:13306/springboot_demo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=DISABLED&connectTimeout=5000&socketTimeout=10000&tcpKeepAlive=true'
DB_USERNAME='springboot_app'
DB_PASSWORD='springboot_local_dev'
DB_MAX_POOL_SIZE='5'
DB_MIN_IDLE='1'

# Dedicated Redis. start-dev.sh automatically opens an SSH tunnel when this
# local endpoint is unavailable.
REDIS_HOST='127.0.0.1'
REDIS_PORT='16379'
REDIS_PASSWORD=''
REDIS_DATABASE='0'
LOCAL_REDIS_PORT='16379'
REMOTE_REDIS_HOST='127.0.0.1'
REMOTE_REDIS_PORT='16379'

# Optional one-time administrator bootstrap. Set both values before the first
# application start, then remove AUTH_BOOTSTRAP_ADMIN_PASSWORD after login works.
AUTH_BOOTSTRAP_ADMIN_USERNAME=''
AUTH_BOOTSTRAP_ADMIN_PASSWORD=''
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME='Administrator'

# Optional: used only by the ECS provisioning and SSH tunnel scripts.
# 203.0.113.10 is a documentation-only example address.
ECS_HOST='203.0.113.10'
ECS_USER='root'
ECS_SSH_PORT='22'
LOCAL_MYSQL_PORT='13306'
REMOTE_MYSQL_HOST='127.0.0.1'
REMOTE_MYSQL_PORT='3306'

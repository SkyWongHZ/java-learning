# This file documents /etc/springboot-demo-test/runtime.env.
# Never commit the real file.

SPRING_PROFILES_ACTIVE=test

DB_URL=jdbc:mysql://my-mysql:3306/springboot_demo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=DISABLED
DB_USERNAME=springboot_app
DB_PASSWORD=replace_me
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1

REDIS_HOST=springboot-demo-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
REDIS_DATABASE=1

APP_CORS_ALLOWED_ORIGINS=http://your-ecs-public-ip

KNIFE4J_ENABLE=true
SWAGGER_ENABLE=true

AUTH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=5
AUTH_LOCK_MINUTES=30
